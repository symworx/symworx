#!/usr/bin/env bash
# SymWorx pre-commit hook (versioned under scripts/githooks/).
#
# Enable once per clone (from the repo root):
#   git config core.hooksPath scripts/githooks
# or:
#   ./scripts/githooks/install
#
# Disable:
#   git config --unset core.hooksPath
#
# Bypass for a single commit (use sparingly):
#   git commit --no-verify

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Hooks often run with a minimal PATH (no login shell). Prefer rustup's cargo.
export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"

# Only gate commits that touch Rust sources or fmt/workspace config.
if ! git diff --cached --name-only --diff-filter=ACM | grep -qE \
  '\.rs$|(^|/)rustfmt\.toml$|(^|/)Cargo\.toml$|(^|/)Cargo\.lock$'; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Resolve how to invoke cargo (host install vs toolbox container).
# ---------------------------------------------------------------------------
SYMWORX_RUST_TOOLBOX="${SYMWORX_RUST_TOOLBOX:-dev-rust}"
CARGO_PREFIX=() # empty → run "cargo …"; or ("toolbox" "run" "-c" "dev-rust")

resolve_cargo() {
  if command -v cargo >/dev/null 2>&1; then
    CARGO_PREFIX=()
    return 0
  fi

  if command -v toolbox >/dev/null 2>&1; then
    # toolbox list --containers is quiet when missing; "run" fails clearly if down.
    if toolbox run -c "$SYMWORX_RUST_TOOLBOX" true >/dev/null 2>&1; then
      if toolbox run -c "$SYMWORX_RUST_TOOLBOX" command -v cargo >/dev/null 2>&1; then
        CARGO_PREFIX=(toolbox run -c "$SYMWORX_RUST_TOOLBOX")
        return 0
      fi
    fi
  fi

  cat >&2 <<EOF
pre-commit: cargo not found on the host PATH, and toolbox fallback failed.

  Host PATH looked in: \$PATH and \$HOME/.cargo/bin
  Toolbox container:   ${SYMWORX_RUST_TOOLBOX}
    (override with: export SYMWORX_RUST_TOOLBOX=your-container)

Fix one of:
  • Commit from an environment where cargo is on PATH, or
  • Start the Rust toolbox:  toolbox enter ${SYMWORX_RUST_TOOLBOX}
    (hook will use: toolbox run -c ${SYMWORX_RUST_TOOLBOX} cargo …), or
  • Bypass once:  git commit --no-verify
EOF
  return 1
}

run_cargo() {
  if ((${#CARGO_PREFIX[@]})); then
    "${CARGO_PREFIX[@]}" cargo "$@"
  else
    cargo "$@"
  fi
}

resolve_cargo || exit 1

if ! run_cargo +nightly fmt --version >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pre-commit: cargo +nightly fmt is required (matches CI).

  rustup toolchain install nightly --component rustfmt

(If using toolbox, run that inside the Rust container.)
Then re-run the commit.
EOF
  exit 1
fi

# Same package set as .github/workflows/ci.yml "Format check (library + bindings, no TUI)".
PKGS=(
  -p symworx-error
  -p symworx-math
  -p symworx-io
  -p symworx-stats
  -p symworx-dynamics
  -p symworx-backend
  -p symworx-signal
  -p symworx-core
  -p symworx-biosym
  -p symworx-loadsym
  -p symworx-loadsym-db
  -p symworx-spatialsym
  -p symworx-python
)

# CI skips TUI/embed for speed; still format-check them when those paths are staged.
staged="$(git diff --cached --name-only --diff-filter=ACM || true)"
if printf '%s\n' "$staged" | grep -qE '(^|/)crates/symworx-tui/'; then
  PKGS+=(-p symworx-tui)
fi
if printf '%s\n' "$staged" | grep -qE '(^|/)crates/symworx-embed/'; then
  PKGS+=(-p symworx-embed)
fi

if ((${#CARGO_PREFIX[@]})); then
  echo "pre-commit: (${CARGO_PREFIX[*]}) cargo +nightly fmt --check ${PKGS[*]}"
else
  echo "pre-commit: cargo +nightly fmt --check ${PKGS[*]}"
fi

if ! run_cargo +nightly fmt --check "${PKGS[@]}"; then
  if ((${#CARGO_PREFIX[@]})); then
    fix_cmd="${CARGO_PREFIX[*]} cargo +nightly fmt"
  else
    fix_cmd="cargo +nightly fmt"
  fi
  cat >&2 <<EOF

pre-commit: rustfmt check failed.

Fix with (from repo root):
  ${fix_cmd}

Then stage the formatting changes and re-commit.
EOF
  exit 1
fi

exit 0
